# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor / ios build artifacts
# (ios/.gitignore covers these inside ios/; these guard the rest of the tree)
DerivedData/
Pods/
build/
*.xcuserdata
*.xcuserstate

# Apple signing/auth keys — never commit
*.p8
AuthKey_*
AppStore submission/01_hero_networth.png
AppStore submission/02_chat.png
AppStore submission/03_diary.png
AppStore submission/04_vitals.png
AppStore submission/05_property.png
AppStore submission/06_perspective.png
