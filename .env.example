# Volnar environment variables. Copy to .env.local and fill in real values.
# Never commit real secrets — this file lists names only.

# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (chat + insights) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cron jobs ──────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Error reporting (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Native app → API origin ────────────────────────────────────────────────────
# Only set in the native (static-export) build; the web build leaves it unset so
# /api calls stay same-origin. See src/lib/api.ts.
NEXT_PUBLIC_API_ORIGIN=

# ── Subscriptions: Stripe (web purchases) ──────────────────────────────────────
# Web purchases go through Stripe Checkout (subscription mode, 14-day card-on-file
# trial). The webhook is the only writer of the web entitlement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs (price_…) for the two plans. €9.99/month and €99.99/year.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── Subscriptions: RevenueCat (mobile purchases via StoreKit / Play Billing) ────
# iOS purchases go through RevenueCat/StoreKit. The appUserID is stamped with the
# Supabase user id so every purchase maps to an account. Public SDK keys are meant
# to ship in the client bundle.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# Google Play is added later through RevenueCat with configuration only — set this
# key (and the Play product mapping below) when the Android target ships.
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Entitlement identifier configured in the RevenueCat dashboard (default: premium).
# Read by both the client (customerInfo check) and the webhook (event mapping).
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=
# Shared secret echoed in the webhook's Authorization header (set in the RevenueCat
# dashboard). The webhook rejects any request whose header does not match.
REVENUECAT_WEBHOOK_AUTH=
# Store product identifiers, used server-side to map a purchase to monthly/annual.
REVENUECAT_MONTHLY_PRODUCT_ID=
REVENUECAT_ANNUAL_PRODUCT_ID=
# Set to "true" ONLY in staging/dev to accept RevenueCat SANDBOX events (TestFlight
# / sandbox purchases). Leave unset in production so a sandbox purchase can never
# grant real paid access.
REVENUECAT_ALLOW_SANDBOX=
